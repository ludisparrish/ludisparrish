      "name": "Product Actions",
      "item": [
        {
          "name": "GET All Products List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Status code is 200",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// 2. Response time is acceptable",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "// 3. Response has responseCode 200",
                  "pm.test(\"Response body has responseCode 200\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.responseCode).to.eql(200);",
                  "});",
                  "",
                  "// 4. Products array exists and is not empty",
                  "pm.test(\"Products list is not empty\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.products).to.be.an(\"array\");",
                  "    pm.expect(json.products.length).to.be.above(0);",
                  "});",
                  "",
                  "// 5. First product has required fields",
                  "pm.test(\"Product object has required fields\", function () {",
                  "    const json = pm.response.json();",
                  "    const product = json.products[0];",
                  "    pm.expect(product).to.have.property(\"id\");",
                  "    pm.expect(product).to.have.property(\"name\");",
                  "    pm.expect(product).to.have.property(\"price\");",
                  "    pm.expect(product).to.have.property(\"brand\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
